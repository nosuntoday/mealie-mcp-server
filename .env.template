# Mealie API Configuration
# Replace these values with your own Mealie instance details

# The base URL of your Mealie instance (including protocol and port if needed)
MEALIE_BASE_URL=https://your-mealie-instance.com

# Your non-admin Mealie API key
# Generate this from your Mealie account settings
MEALIE_API_KEY=your-mealie-api-key

LOG_LEVEL=INFO

# Opt in to the AI import tool (Mealie 3.23.0+ with a default AI provider).
# Only true/false are accepted. Restart the server after changing this.
MEALIE_ENABLE_AI_IMPORT=false

# Transport mode: "stdio" (default, for local Claude Desktop) or "streamable-http" (for remote/multi-client access)
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Remote HTTP allowlists; preserve loopback for the Docker healthcheck.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
